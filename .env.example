# MindGains — environment variables (names only; fill with real values in .env, never commit .env)
# EXPO_PUBLIC_* are embedded in the client bundle → only put NON-secret values here.
# Secret keys (AI, Redis) now live server-side in Supabase edge function secrets — NOT here.

# --- Supabase (public, gated by RLS) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- RevenueCat (public SDK key, Android) ---
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# --- MIGA story/tutor server (public URL; deployed on Railway) ---
EXPO_PUBLIC_STORY_BASE_URL=https://miga-server-production.up.railway.app

# --- Client config (non-secret) ---
EXPO_PUBLIC_OPENROUTER_MODEL=
EXPO_PUBLIC_TUTOR_MODEL=
EXPO_PUBLIC_REQUIRE_VERIFIED_QUESTIONS=

# (optional) crash reporting — see Sentry setup
EXPO_PUBLIC_SENTRY_DSN=

# ============================================================================
# SERVER-SIDE ONLY — set these as Supabase function secrets (`supabase secrets set`),
# NOT as EXPO_PUBLIC_*. They must never reach the client bundle.
#   OPENROUTER_API_KEY            (used by companion_chat, miga_math_solve, …)
#   OPENROUTER_MODEL
#   UPSTASH_REDIS_REST_URL        (used by redis_proxy)
#   UPSTASH_REDIS_REST_TOKEN
# The MIGA server (bot/) keeps its own bot/.env with OpenAI/AWS/TTS keys.
# ============================================================================
